{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "parisien-90.vercel.app"
        }
      ],
      "destination": "https://parisien90.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.parisien90.com"
        }
      ],
      "destination": "https://parisien90.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/source-audit",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/source-audit",
      "schedule": "0 10 * * *"
    }
  ]
}
